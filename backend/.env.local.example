# Read by the `npx convex` CLI only. Convex functions never see this file.
CONVEX_SELF_HOSTED_URL='http://127.0.0.1:3210'
CONVEX_SELF_HOSTED_ADMIN_KEY='replace with the key from generate_admin_key.sh'

# Runtime settings live on the deployment, not here. Set them with:
#   npx convex env set OKIDOKI_SYNC_SECRET "<long random string; paste the same value in okidoki → keys → convex sync secret>"
#   npx convex env set OKIDOKI_SHARE_BASE_URL "https://your-hosted-control-panel.example.com"
# The sync endpoints reject every request until OKIDOKI_SYNC_SECRET is set.
