{
  "name": "okidoki-brain",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build src/server.ts --outfile dist/server.js --target=bun --external @moss-js/moss",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "smoke:api": "bun scripts/smoke-api.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@moss-js/moss": "1.21.0"
  }
}
